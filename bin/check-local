#!/usr/bin/env bash

# SPDX-FileCopyrightText: 2026 Xquik contributors
#
# SPDX-License-Identifier: Apache-2.0

# Runs every repository check on this machine and stops at the first failure.
# CodeQL is mandatory, so install the CLI first: brew install --cask codeql.
#
# It posts the result as the xquik-local-checks commit status with the gh login
# of the person running it, which is the owner's login on the release machine.
# It posts success only after every mandatory check passed, and the status text
# lists only the checks that ran. Pass --no-status to skip the commit status.

set -euo pipefail

cd -- "$(dirname -- "$0")/.."

readonly status_repo="Xquik-dev/x-twitter-scraper-ruby"
readonly status_context="xquik-local-checks"
readonly codeql_suite="codeql/ruby-queries:codeql-suites/ruby-security-extended.qls"

export BUNDLE_FROZEN=true

post_enabled=true
for arg in "$@"; do
  case "$arg" in
    --no-status) post_enabled=false ;;
    *)
      echo "Unknown option ${arg}. The only option is --no-status." >&2
      exit 2
      ;;
  esac
done

status_sha=""
if [[ "$post_enabled" == false ]]; then
  echo "Commit status not posted: --no-status was passed."
elif ! command -v gh >/dev/null 2>&1; then
  echo "Commit status not posted: the GitHub CLI is not installed."
elif [[ -n "$(git status --porcelain)" ]]; then
  echo "Commit status not posted: the working tree has uncommitted changes."
else
  head_sha="$(git rev-parse HEAD)"
  if gh api "repos/${status_repo}/commits/${head_sha}" --silent >/dev/null 2>&1; then
    status_sha="$head_sha"
  else
    echo "Commit status not posted: commit ${head_sha:0:7} is not on GitHub. Push it first."
  fi
fi

post_status() {
  local state="$1"
  local description="${2:0:139}"

  if [[ -z "$status_sha" ]]; then
    return 0
  fi
  if ! gh api "repos/${status_repo}/statuses/${status_sha}" --silent \
    -f state="$state" -f context="$status_context" -f description="$description" >/dev/null 2>&1; then
    echo "Commit status ${state} not posted: GitHub rejected it. Run gh auth status to check access." >&2
  fi
}

current_check=""
current_next_step=""
success_summary=""
passed_checks=()
test_log="$(mktemp)"
codeql_dir="$(mktemp -d)"

finish() {
  local exit_code=$?

  if [[ "$exit_code" -eq 0 && -n "$success_summary" ]]; then
    post_status success "$success_summary"
  elif [[ -n "$current_check" ]]; then
    post_status failure "${current_check} check failed. ${current_next_step}"
  else
    post_status failure "Local checks stopped early. Run bin/check-local for details."
  fi
  if [[ -n "${test_log:-}" ]]; then
    rm -f -- "$test_log"
  fi
  if [[ -n "${codeql_dir:-}" && -d "$codeql_dir" ]]; then
    rm -rf -- "$codeql_dir"
  fi
}
trap finish EXIT

post_status pending "Local checks are running."

# run_check <name> <status label, empty for setup steps> <next step> <command...>
run_check() {
  local name="$1"
  local label="$2"
  local next_step="$3"
  shift 3

  current_check="$name"
  current_next_step="$next_step"
  echo "==> ${name}"
  if ! "$@"; then
    echo "Check failed: ${name}. ${next_step}" >&2
    exit 1
  fi
  current_check=""
  if [[ -n "$label" ]]; then
    passed_checks+=("$label")
  fi
}

has_codeql() {
  command -v codeql >/dev/null 2>&1
}

run_tests() {
  local test_script="./scripts/test"
  "$test_script" | tee "$test_log"
}

run_codeql() {
  codeql database create "${codeql_dir}/database" --language=ruby --build-mode=none \
    --source-root=. --overwrite --quiet
  codeql database analyze "${codeql_dir}/database" "$codeql_suite" --download \
    --format=sarif-latest --output="${codeql_dir}/results.sarif" --quiet
  ruby -rjson -e '
    results = JSON.parse(File.read(ARGV.fetch(0))).fetch("runs").flat_map { |run| run.fetch("results", []) }
    results.each do |result|
      location = result.dig("locations", 0, "physicalLocation") || {}
      file = location.dig("artifactLocation", "uri")
      line = location.dig("region", "startLine")
      puts("#{result["ruleId"]} at #{file}:#{line}: #{result.dig("message", "text")}")
    end
    abort("CodeQL reported #{results.length} finding(s).") unless results.empty?
    puts("CodeQL reported no findings.")
  ' "${codeql_dir}/results.sarif"
}

run_check "Installed gems" "" \
  "Run ./scripts/bootstrap to install the locked gems." \
  bundle check

run_check "CodeQL CLI" "" \
  "Install it with brew install --cask codeql." \
  has_codeql

run_check "Reproducible gem build" "reproducible build" \
  "Remove nondeterministic build inputs, then rerun bin/check-local." \
  bundle exec ruby scripts/check_reproducible.rb

run_check "Lint and type checks" "lint & types" \
  "Fix the reported offenses. Run ./scripts/format for style issues." \
  ./scripts/lint

run_check "Dependency audit" "audit" \
  "Fix the blocking advisories listed above, then rerun bin/check-local." \
  bundle exec ruby scripts/audit.rb

run_check "Tests" "tests" \
  "Fix the failing tests, then rerun bin/check-local." \
  run_tests

test_counts="$(sed -n -E 's/^([0-9]+) runs, .*, ([0-9]+) skips$/\1 \2/p' "$test_log" | tail -n 1)"
if [[ -n "$test_counts" ]]; then
  read -r test_runs test_skips <<<"$test_counts"
  passed_checks[${#passed_checks[@]} - 1]="tests ($((test_runs - test_skips)) passed)"
fi

run_check "Coverage" "coverage" \
  "Add tests until coverage meets the thresholds." \
  bundle exec ruby scripts/coverage.rb

run_check "CodeQL security-extended scan" "CodeQL" \
  "Fix the CodeQL findings listed above, then rerun bin/check-local." \
  run_codeql

skipped_note=""
if command -v reuse >/dev/null 2>&1; then
  run_check "REUSE license compliance" "REUSE" \
    "Add SPDX license data for the reported files." \
    reuse lint
else
  echo "==> Skipping REUSE license compliance: reuse is not installed. Install it with pipx install reuse."
  skipped_note=" REUSE skipped."
fi

passed_list="${passed_checks[0]}"
for label in "${passed_checks[@]:1}"; do
  passed_list+=", ${label}"
done
success_summary="Passed: ${passed_list}.${skipped_note}"

echo "All checks passed. ${success_summary}"
