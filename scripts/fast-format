#!/usr/bin/env bash

# SPDX-FileCopyrightText: 2026 Xquik contributors
#
# SPDX-License-Identifier: Apache-2.0

set -euo pipefail

cd -- "$(dirname "$0")/.."

if [ $# -eq 0 ]; then
    echo "Usage: $0 <path-list>"
    echo "Path list must contain one file per line."
    exit 1
fi

exec -- bundle exec rake format FORMAT_FILE="$1"
