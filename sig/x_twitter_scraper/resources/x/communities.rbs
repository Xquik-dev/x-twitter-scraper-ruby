module XTwitterScraper
  module Resources
    class X
      class Communities
        attr_reader join: XTwitterScraper::Resources::X::Communities::Join

        attr_reader tweets: XTwitterScraper::Resources::X::Communities::Tweets

        def create: (
          account: String,
          name: String,
          idempotency_key: String,
          ?description: String,
          ?request_options: XTwitterScraper::request_opts
        ) -> XTwitterScraper::Models::X::CommunityCreateResponse

        def delete: (
          String id,
          account: String,
          community_name: String,
          idempotency_key: String,
          ?request_options: XTwitterScraper::request_opts
        ) -> XTwitterScraper::Models::X::CommunityDeleteResponse

        def retrieve_info: (
          String id,
          ?fields: String,
          ?omit: String,
          ?request_options: XTwitterScraper::request_opts
        ) -> XTwitterScraper::Models::X::CommunityRetrieveInfoResponse

        def retrieve_members: (
          String id,
          ?bio_contains: String,
          ?blue_verified_only: bool,
          ?business_email_only: bool,
          ?cursor: String,
          ?email_domains: String,
          ?fields: String,
          ?has_email: bool,
          ?has_location: bool,
          ?has_website: bool,
          ?location_contains: String,
          ?max_followers: Integer,
          ?max_following: Integer,
          ?max_statuses: Integer,
          ?min_account_age_days: Integer,
          ?min_followers: Integer,
          ?min_following: Integer,
          ?min_statuses: Integer,
          ?omit: String,
          ?page_size: Integer,
          ?username_contains: String,
          ?verified_only: bool,
          ?verified_type: String,
          ?request_options: XTwitterScraper::request_opts
        ) -> XTwitterScraper::PaginatedUsers

        def retrieve_moderators: (
          String id,
          ?bio_contains: String,
          ?blue_verified_only: bool,
          ?business_email_only: bool,
          ?cursor: String,
          ?email_domains: String,
          ?fields: String,
          ?has_email: bool,
          ?has_location: bool,
          ?has_website: bool,
          ?location_contains: String,
          ?max_followers: Integer,
          ?max_following: Integer,
          ?max_statuses: Integer,
          ?min_account_age_days: Integer,
          ?min_followers: Integer,
          ?min_following: Integer,
          ?min_statuses: Integer,
          ?omit: String,
          ?username_contains: String,
          ?verified_only: bool,
          ?verified_type: String,
          ?request_options: XTwitterScraper::request_opts
        ) -> XTwitterScraper::PaginatedUsers

        def retrieve_search: (
          community_id: String,
          q: String,
          ?any_words: String,
          ?blue_verified_only: bool,
          ?cashtags: String,
          ?conversation_id: String,
          ?cursor: String,
          ?exact_phrase: String,
          ?exclude_words: String,
          ?fields: String,
          ?from_user: String,
          ?hashtags: String,
          ?in_reply_to_tweet_id: String,
          ?language: String,
          ?max_faves: Integer,
          ?max_id: String,
          ?max_quotes: Integer,
          ?max_replies: Integer,
          ?max_retweets: Integer,
          ?mentioning: String,
          ?min_bookmarks: Integer,
          ?min_likes: Integer,
          ?min_quotes: Integer,
          ?min_replies: Integer,
          ?min_retweets: Integer,
          ?min_views: Integer,
          ?native_retweets: bool,
          ?omit: String,
          ?page_size: Integer,
          ?query_type: XTwitterScraper::Models::X::CommunityRetrieveSearchParams::query_type,
          ?quotes_of_tweet_id: String,
          ?retweets_of_tweet_id: String,
          ?since_date: Date,
          ?since_id: String,
          ?to_user: String,
          ?until_date: Date,
          ?url: String,
          ?verified_only: bool,
          ?within_time: String,
          ?request_options: XTwitterScraper::request_opts
        ) -> XTwitterScraper::PaginatedTweets

        def initialize: (client: XTwitterScraper::Client) -> void
      end
    end
  end
end
