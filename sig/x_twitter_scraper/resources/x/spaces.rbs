module XTwitterScraper
  module Resources
    class X
      class Spaces
        def search: (
          q: String,
          ?query_type: XTwitterScraper::Models::X::SpaceSearchParams::query_type,
          ?cursor: String,
          ?page_size: Integer,
          ?fields: String,
          ?omit: String,
          ?request_options: XTwitterScraper::request_opts
        ) -> XTwitterScraper::Models::X::SpaceSearchResponse

        def retrieve: (
          String id,
          ?fields: String,
          ?omit: String,
          ?request_options: XTwitterScraper::request_opts
        ) -> XTwitterScraper::Models::X::SpaceRetrieveResponse

        def retrieve_replay: (
          String id,
          ?fields: String,
          ?omit: String,
          ?request_options: XTwitterScraper::request_opts
        ) -> XTwitterScraper::Models::X::SpaceRetrieveReplayResponse

        def initialize: (client: XTwitterScraper::Client) -> void
      end
    end
  end
end
