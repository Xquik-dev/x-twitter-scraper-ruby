module XTwitterScraper
  module Resources
    class X
      class AccountConnectionLinks
        def create: (
          ?reference: String,
          ?return_url: String,
          ?account_id: String,
          ?request_options: XTwitterScraper::request_opts
        ) -> XTwitterScraper::Models::X::AccountConnectionLinkCreateResponse

        def retrieve: (
          String id,
          ?request_options: XTwitterScraper::request_opts
        ) -> XTwitterScraper::X::XAccountConnectionLink

        def revoke: (
