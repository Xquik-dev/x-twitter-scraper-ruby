module XTwitterScraper
  module Resources
    class Monitors
      attr_reader keywords: XTwitterScraper::Resources::Monitors::Keywords

      def create: (
        event_types: ::Array[XTwitterScraper::Models::event_type],
        username: String,
        ?name: String,
        ?request_options: XTwitterScraper::request_opts
      ) -> XTwitterScraper::Models::MonitorCreateResponse

      def retrieve: (
        String id,
        ?request_options: XTwitterScraper::request_opts
      ) -> XTwitterScraper::Monitor

      def update: (
        String id,
        ?event_types: ::Array[XTwitterScraper::Models::event_type],
        ?is_active: bool,
        ?name: String?,
        ?request_options: XTwitterScraper::request_opts
      ) -> XTwitterScraper::Monitor

      def list: (
        ?cursor: String,
        ?limit: Integer,
        ?request_options: XTwitterScraper::request_opts
      ) -> XTwitterScraper::Models::MonitorListResponse

      def deactivate: (
        String id,
        ?request_options: XTwitterScraper::request_opts
      ) -> XTwitterScraper::Models::MonitorDeactivateResponse

      def initialize: (client: XTwitterScraper::Client) -> void
    end
  end
end
