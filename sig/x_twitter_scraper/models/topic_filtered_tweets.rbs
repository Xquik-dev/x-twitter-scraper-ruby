module XTwitterScraper
  module Models
    type topic_filtered_tweets =
      {
        topic_filter: XTwitterScraper::Models::TopicFilterSummary,
        tweets: ::Array[XTwitterScraper::Models::TopicFilteredTweets::Tweet]
      }

    class TopicFilteredTweets < XTwitterScraper::Models::PaginatedTweets
      attr_accessor topic_filter: XTwitterScraper::Models::TopicFilterSummary

      def tweets: -> ::Array[XTwitterScraper::Models::TopicFilteredTweets::Tweet]

      def tweets=: (
        ::Array[XTwitterScraper::Models::TopicFilteredTweets::Tweet] _
      ) -> ::Array[XTwitterScraper::Models::TopicFilteredTweets::Tweet]

      def initialize: (
        topic_filter: XTwitterScraper::Models::TopicFilterSummary,
        tweets: ::Array[XTwitterScraper::Models::TopicFilteredTweets::Tweet]
      ) -> void

      def to_hash: -> {
        topic_filter: XTwitterScraper::Models::TopicFilterSummary,
        tweets: ::Array[XTwitterScraper::Models::TopicFilteredTweets::Tweet]
      }

      type tweet = { topic_score: Float }

      class Tweet < XTwitterScraper::Models::SearchTweet
        attr_accessor topic_score: Float

        def initialize: (topic_score: Float) -> void

        def to_hash: -> { topic_score: Float }
      end
    end
  end
end
