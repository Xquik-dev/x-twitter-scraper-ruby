module XTwitterScraper
  module Models
    type extraction_job =
      {
        id: String,
        created_at: Time,
        status: XTwitterScraper::Models::ExtractionJob::status,
        tool_type: XTwitterScraper::Models::ExtractionJob::tool_type,
        total_results: Integer,
        url: String,
        completed_at: Time,
        completion_reason: XTwitterScraper::Models::ExtractionJob::completion_reason,
        effective_results_limit: Integer,
        error_message: String,
        image_filter: XTwitterScraper::ImageFilterSummary,
        results_limit: Integer,
        topic_filter: XTwitterScraper::ExtractionJob::TopicFilter
      }

    class ExtractionJob < XTwitterScraper::Internal::Type::BaseModel
      attr_accessor id: String

      attr_accessor created_at: Time

      attr_accessor status: XTwitterScraper::Models::ExtractionJob::status

      attr_accessor tool_type: XTwitterScraper::Models::ExtractionJob::tool_type

      attr_accessor total_results: Integer

      attr_accessor url: String

      attr_reader completed_at: Time?

      def completed_at=: (Time) -> Time

      attr_reader completion_reason: XTwitterScraper::Models::ExtractionJob::completion_reason?

      def completion_reason=: (
        XTwitterScraper::Models::ExtractionJob::completion_reason
      ) -> XTwitterScraper::Models::ExtractionJob::completion_reason

      attr_reader effective_results_limit: Integer?

      def effective_results_limit=: (Integer) -> Integer

      attr_reader error_message: String?

      def error_message=: (String) -> String

      attr_reader image_filter: XTwitterScraper::ImageFilterSummary?

      def image_filter=: (
        XTwitterScraper::ImageFilterSummary | ::Hash[Symbol, top]
      ) -> XTwitterScraper::ImageFilterSummary

      attr_reader results_limit: Integer?

      def results_limit=: (Integer) -> Integer

      attr_reader topic_filter: XTwitterScraper::ExtractionJob::TopicFilter?

      def topic_filter=: (
        XTwitterScraper::ExtractionJob::TopicFilter | ::Hash[Symbol, top]
      ) -> XTwitterScraper::ExtractionJob::TopicFilter

      def initialize: (
        id: String,
        created_at: Time,
        status: XTwitterScraper::Models::ExtractionJob::status,
        tool_type: XTwitterScraper::Models::ExtractionJob::tool_type,
        total_results: Integer,
        url: String,
        ?completed_at: Time,
        ?completion_reason: XTwitterScraper::Models::ExtractionJob::completion_reason,
        ?effective_results_limit: Integer,
        ?error_message: String,
        ?image_filter: XTwitterScraper::ImageFilterSummary | ::Hash[Symbol, top],
        ?results_limit: Integer,
        ?topic_filter: XTwitterScraper::ExtractionJob::TopicFilter | ::Hash[Symbol, top]
      ) -> void

      def to_hash: -> {
        id: String,
        created_at: Time,
        status: XTwitterScraper::Models::ExtractionJob::status,
        tool_type: XTwitterScraper::Models::ExtractionJob::tool_type,
        total_results: Integer,
        url: String,
        completed_at: Time,
        completion_reason: XTwitterScraper::Models::ExtractionJob::completion_reason,
        effective_results_limit: Integer,
        error_message: String,
        image_filter: XTwitterScraper::ImageFilterSummary,
        results_limit: Integer,
        topic_filter: XTwitterScraper::ExtractionJob::TopicFilter
      }

      type status = :running | :completed | :failed | :pending | :canceled

      module Status
        extend XTwitterScraper::Internal::Type::Enum

        RUNNING: :running
        COMPLETED: :completed
        FAILED: :failed
        PENDING: :pending
        CANCELED: :canceled

        def self?.values: -> ::Array[XTwitterScraper::Models::ExtractionJob::status]
      end

      type tool_type =
        :article_extractor
        | :community_extractor
        | :community_moderator_explorer
        | :community_post_extractor
        | :community_search
        | :favoriters
        | :follower_explorer
        | :following_explorer
        | :list_follower_explorer
        | :list_member_extractor
        | :list_post_extractor
        | :mention_extractor
        | :people_search
        | :post_extractor
        | :quote_extractor
        | :reply_extractor
        | :repost_extractor
        | :space_explorer
        | :thread_extractor
        | :tweet_search_extractor
        | :user_affiliates
        | :user_likes
        | :user_media
        | :verified_follower_explorer

      module ToolType
        extend XTwitterScraper::Internal::Type::Enum

        ARTICLE_EXTRACTOR: :article_extractor
        COMMUNITY_EXTRACTOR: :community_extractor
        COMMUNITY_MODERATOR_EXPLORER: :community_moderator_explorer
        COMMUNITY_POST_EXTRACTOR: :community_post_extractor
        COMMUNITY_SEARCH: :community_search
        FAVORITERS: :favoriters
        FOLLOWER_EXPLORER: :follower_explorer
        FOLLOWING_EXPLORER: :following_explorer
        LIST_FOLLOWER_EXPLORER: :list_follower_explorer
        LIST_MEMBER_EXTRACTOR: :list_member_extractor
        LIST_POST_EXTRACTOR: :list_post_extractor
        MENTION_EXTRACTOR: :mention_extractor
        PEOPLE_SEARCH: :people_search
        POST_EXTRACTOR: :post_extractor
        QUOTE_EXTRACTOR: :quote_extractor
        REPLY_EXTRACTOR: :reply_extractor
        REPOST_EXTRACTOR: :repost_extractor
        SPACE_EXPLORER: :space_explorer
        THREAD_EXTRACTOR: :thread_extractor
        TWEET_SEARCH_EXTRACTOR: :tweet_search_extractor
        USER_AFFILIATES: :user_affiliates
        USER_LIKES: :user_likes
        USER_MEDIA: :user_media
        VERIFIED_FOLLOWER_EXPLORER: :verified_follower_explorer

        def self?.values: -> ::Array[XTwitterScraper::Models::ExtractionJob::tool_type]
      end

      type completion_reason =
        :budget_limited
        | :canceled
        | :deadline_reached
        | :failed
        | :pagination_safety_limit
        | :partial_failure
        | :requested_limit_reached
        | :source_exhausted

      module CompletionReason
        extend XTwitterScraper::Internal::Type::Enum

        BUDGET_LIMITED: :budget_limited
        CANCELED: :canceled
        DEADLINE_REACHED: :deadline_reached
        FAILED: :failed
        PAGINATION_SAFETY_LIMIT: :pagination_safety_limit
        PARTIAL_FAILURE: :partial_failure
        REQUESTED_LIMIT_REACHED: :requested_limit_reached
        SOURCE_EXHAUSTED: :source_exhausted

        def self?.values: -> ::Array[XTwitterScraper::Models::ExtractionJob::completion_reason]
      end

      type topic_filter = ::Hash[Symbol, top]

      class TopicFilter < XTwitterScraper::Internal::Type::BaseModel
        attr_accessor topic: String

        attr_accessor question: String

        attr_accessor cutoff: Float

        attr_accessor checked: Integer

        attr_accessor kept: Integer

        attr_accessor unchecked: ::Array[XTwitterScraper::ExtractionJob::TopicFilter::Unchecked]

        def initialize: (
          topic: String,
          question: String,
          cutoff: Float,
          checked: Integer,
          kept: Integer,
          unchecked: ::Array[XTwitterScraper::ExtractionJob::TopicFilter::Unchecked | ::Hash[Symbol, top]]
        ) -> void

        def to_hash: -> ::Hash[Symbol, top]

        type unchecked_ = ::Hash[Symbol, top]

        class Unchecked < XTwitterScraper::Internal::Type::BaseModel
          attr_accessor id: String

          attr_accessor reason: String

          def initialize: (id: String, reason: String) -> void

          def to_hash: -> ::Hash[Symbol, top]
        end
      end
    end
  end
end
