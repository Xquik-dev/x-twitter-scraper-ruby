          subject: String,
          attachments: ::Array[XTwitterScraper::Internal::file_input],
          idempotency_key: String
        }
        & XTwitterScraper::Internal::Type::request_parameters

      class TicketCreateParams < XTwitterScraper::Internal::Type::BaseModel
        extend XTwitterScraper::Internal::Type::RequestParameters::Converter
        include XTwitterScraper::Internal::Type::RequestParameters

        attr_reader body: String?

        def body=: (String) -> String

        attr_accessor subject: String

        attr_reader attachments: ::Array[XTwitterScraper::Internal::file_input]?

        def attachments=: (
          ::Array[XTwitterScraper::Internal::file_input]
        ) -> ::Array[XTwitterScraper::Internal::file_input]

