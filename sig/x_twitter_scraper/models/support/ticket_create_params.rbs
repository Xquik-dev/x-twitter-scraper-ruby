        def idempotency_key=: (String) -> String

        def initialize: (
          subject: String,
          ?attachments: ::Array[XTwitterScraper::Internal::file_input],
          ?body: String,
          ?idempotency_key: String,
          ?request_options: XTwitterScraper::request_opts
        ) -> void

        def to_hash: -> {
          body: String,
          subject: String,
          attachments: ::Array[XTwitterScraper::Internal::file_input],
