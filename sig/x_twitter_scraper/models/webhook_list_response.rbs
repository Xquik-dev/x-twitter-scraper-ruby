module XTwitterScraper
  module Models
    type webhook_list_response =
      {
        has_more: bool,
        webhooks: ::Array[XTwitterScraper::Webhook],
        next_cursor: String
      }

    class WebhookListResponse < XTwitterScraper::Internal::Type::BaseModel
      attr_accessor has_more: bool

      attr_accessor webhooks: ::Array[XTwitterScraper::Webhook]

      attr_reader next_cursor: String?

      def next_cursor=: (String) -> String

      def initialize: (
        has_more: bool,
        webhooks: ::Array[XTwitterScraper::Webhook],
        ?next_cursor: String
      ) -> void

      def to_hash: -> {
        has_more: bool,
        webhooks: ::Array[XTwitterScraper::Webhook],
        next_cursor: String
      }
    end
  end
end
