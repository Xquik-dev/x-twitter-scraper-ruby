module XTwitterScraper
  module Models
    type community =
      {
        id: String,
        name: String,
        description: String,
        member_count: Integer,
        moderator_count: Integer,
        is_nsfw: bool,
        primary_topic: XTwitterScraper::Models::Community::PrimaryTopic,
        created_at: String,
        join_policy: String,
        invites_policy: String,
        question: String,
        rules: ::Array[XTwitterScraper::Models::Community::Rule],
        search_tags: ::Array[String],
        creator: XTwitterScraper::Models::Community::Creator,
        admin: XTwitterScraper::Models::UserProfile,
        members_facepile: ::Array[XTwitterScraper::Models::Community::members_facepile],
        banner_url: String,
        banner: XTwitterScraper::Models::CommunityBanner
      }

    class Community < XTwitterScraper::Internal::Type::BaseModel
      attr_accessor id: String

      attr_accessor name: String

      attr_reader description: String?

      def description=: (String) -> String

      attr_accessor member_count: Integer

      attr_reader moderator_count: Integer?

      def moderator_count=: (Integer) -> Integer

      attr_accessor is_nsfw: bool

      attr_reader primary_topic: XTwitterScraper::Models::Community::PrimaryTopic?

      def primary_topic=: (
        XTwitterScraper::Models::Community::PrimaryTopic
      ) -> XTwitterScraper::Models::Community::PrimaryTopic

      attr_reader created_at: String?

      def created_at=: (String) -> String

      attr_reader join_policy: String?

      def join_policy=: (String) -> String

      attr_reader invites_policy: String?

      def invites_policy=: (String) -> String

      attr_reader question: String?

      def question=: (String) -> String

      attr_reader rules: ::Array[XTwitterScraper::Models::Community::Rule]?

      def rules=: (
        ::Array[XTwitterScraper::Models::Community::Rule]
      ) -> ::Array[XTwitterScraper::Models::Community::Rule]

      attr_reader search_tags: ::Array[String]?

      def search_tags=: (::Array[String]) -> ::Array[String]

      attr_reader creator: XTwitterScraper::Models::Community::Creator?

      def creator=: (
        XTwitterScraper::Models::Community::Creator
      ) -> XTwitterScraper::Models::Community::Creator

      attr_reader admin: XTwitterScraper::Models::UserProfile?

      def admin=: (
        XTwitterScraper::Models::UserProfile
      ) -> XTwitterScraper::Models::UserProfile

      attr_reader members_facepile: ::Array[XTwitterScraper::Models::Community::members_facepile]?

      def members_facepile=: (
        ::Array[XTwitterScraper::Models::Community::members_facepile]
      ) -> ::Array[XTwitterScraper::Models::Community::members_facepile]

      attr_reader banner_url: String?

      def banner_url=: (String) -> String

      attr_reader banner: XTwitterScraper::Models::CommunityBanner?

      def banner=: (
        XTwitterScraper::Models::CommunityBanner
      ) -> XTwitterScraper::Models::CommunityBanner

      def initialize: (
        id: String,
        name: String,
        member_count: Integer,
        is_nsfw: bool,
        ?description: String,
        ?moderator_count: Integer,
        ?primary_topic: XTwitterScraper::Models::Community::PrimaryTopic,
        ?created_at: String,
        ?join_policy: String,
        ?invites_policy: String,
        ?question: String,
        ?rules: ::Array[XTwitterScraper::Models::Community::Rule],
        ?search_tags: ::Array[String],
        ?creator: XTwitterScraper::Models::Community::Creator,
        ?admin: XTwitterScraper::Models::UserProfile,
        ?members_facepile: ::Array[XTwitterScraper::Models::Community::members_facepile],
        ?banner_url: String,
        ?banner: XTwitterScraper::Models::CommunityBanner
      ) -> void

      def to_hash: -> {
        id: String,
        name: String,
        description: String,
        member_count: Integer,
