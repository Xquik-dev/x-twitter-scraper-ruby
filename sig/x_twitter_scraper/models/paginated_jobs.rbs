module XTwitterScraper
  module Models
    type paginated_jobs =
      {
        jobs: ::Array[XTwitterScraper::Models::Job],
        has_next_page: bool,
        next_cursor: String
      }

    class PaginatedJobs < XTwitterScraper::Internal::Type::BaseModel
      attr_accessor jobs: ::Array[XTwitterScraper::Models::Job]

      attr_accessor has_next_page: bool

      attr_accessor next_cursor: String

      def initialize: (
        jobs: ::Array[XTwitterScraper::Models::Job],
        has_next_page: bool,
        next_cursor: String
      ) -> void

      def to_hash: -> {
        jobs: ::Array[XTwitterScraper::Models::Job],
        has_next_page: bool,
        next_cursor: String
      }
    end
  end
end
