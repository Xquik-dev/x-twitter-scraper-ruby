module XTwitterScraper
  module Models
    type user_list_page =
      {
        scan_limit: XTwitterScraper::Models::UserListPage::ScanLimit,
        window_complete: bool
      }

    class UserListPage < XTwitterScraper::Models::PaginatedUsers
      attr_reader scan_limit: XTwitterScraper::Models::UserListPage::ScanLimit?

      def scan_limit=: (
        XTwitterScraper::Models::UserListPage::ScanLimit
      ) -> XTwitterScraper::Models::UserListPage::ScanLimit

      attr_reader window_complete: bool?

      def window_complete=: (bool) -> bool

      def initialize: (
        ?scan_limit: XTwitterScraper::Models::UserListPage::ScanLimit,
        ?window_complete: bool
      ) -> void

      def to_hash: -> {
        scan_limit: XTwitterScraper::Models::UserListPage::ScanLimit,
        window_complete: bool
      }

      type scan_limit = { limit: 100000, message: String, rows_read: Integer }

      class ScanLimit < XTwitterScraper::Internal::Type::BaseModel
        attr_accessor limit: 100000

        attr_accessor message: String

        attr_accessor rows_read: Integer

        def initialize: (
          message: String,
          rows_read: Integer,
          ?limit: 100000
        ) -> void

        def to_hash: -> { limit: 100000, message: String, rows_read: Integer }
      end
    end
  end
end
