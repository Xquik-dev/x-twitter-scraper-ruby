module XTwitterScraper
  module Models
    type search_suggestion_hashtag =
      { hashtag: String, score: Float, tokens: ::Array[String], inline: bool }

    class SearchSuggestionHashtag < XTwitterScraper::Internal::Type::BaseModel
      attr_accessor hashtag: String

      attr_reader score: Float?

      def score=: (Float) -> Float

      attr_reader tokens: ::Array[String]?

      def tokens=: (::Array[String]) -> ::Array[String]

      attr_reader inline: bool?

      def inline=: (bool) -> bool

      def initialize: (
        hashtag: String,
        ?score: Float,
        ?tokens: ::Array[String],
        ?inline: bool
      ) -> void

      def to_hash: -> {
        hashtag: String,
        score: Float,
        tokens: ::Array[String],
        inline: bool
      }
    end
  end
end
