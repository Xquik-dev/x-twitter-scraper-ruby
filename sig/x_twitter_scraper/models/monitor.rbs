module XTwitterScraper
  module Models
    type monitor =
      {
        id: String,
        created_at: Time,
        event_types: ::Array[XTwitterScraper::Models::event_type],
        is_active: bool,
        next_billing_at: Time,
        username: String,
        x_user_id: String,
        paused_at: Time,
        paused_reason: XTwitterScraper::Models::Monitor::paused_reason
      }

    class Monitor < XTwitterScraper::Internal::Type::BaseModel
      attr_accessor id: String

      attr_accessor created_at: Time

      attr_accessor event_types: ::Array[XTwitterScraper::Models::event_type]

      attr_accessor is_active: bool

      attr_accessor next_billing_at: Time

      attr_accessor username: String

      attr_accessor x_user_id: String

      attr_reader paused_at: Time?

      def paused_at=: (Time) -> Time

      attr_reader paused_reason: XTwitterScraper::Models::Monitor::paused_reason?

      def paused_reason=: (
        XTwitterScraper::Models::Monitor::paused_reason
      ) -> XTwitterScraper::Models::Monitor::paused_reason

      def initialize: (
        id: String,
        created_at: Time,
        event_types: ::Array[XTwitterScraper::Models::event_type],
        is_active: bool,
        next_billing_at: Time,
        username: String,
        x_user_id: String,
        ?paused_at: Time,
        ?paused_reason: XTwitterScraper::Models::Monitor::paused_reason
      ) -> void

      def to_hash: -> {
        id: String,
        created_at: Time,
        event_types: ::Array[XTwitterScraper::Models::event_type],
        is_active: bool,
        next_billing_at: Time,
        username: String,
        x_user_id: String,
        paused_at: Time,
        paused_reason: XTwitterScraper::Models::Monitor::paused_reason
      }

      type paused_reason = :x_user_not_found

      module PausedReason
        extend XTwitterScraper::Internal::Type::Enum

        X_USER_NOT_FOUND: :x_user_not_found

        def self?.values: -> ::Array[XTwitterScraper::Models::Monitor::paused_reason]
      end
    end
  end
end
