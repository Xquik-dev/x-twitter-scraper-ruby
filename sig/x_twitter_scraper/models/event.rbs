module XTwitterScraper
  module Models
    type event =
      {
        id: String,
        data: ::Hash[Symbol, top],
        monitor_id: String,
        monitor_type: XTwitterScraper::Models::Event::monitor_type,
        occurred_at: Time,
        type: XTwitterScraper::Models::stream_event_type,
        author_id: String,
        author_username: String,
        keyword_monitor_id: String,
        monitor_name: String,
        post_id: String,
        post_url: String,
        query: String,
        username: String,
        x_user_id: String
      }

    class Event < XTwitterScraper::Internal::Type::BaseModel
      attr_accessor id: String

      attr_accessor data: ::Hash[Symbol, top]

      attr_accessor monitor_id: String

      attr_accessor monitor_type: XTwitterScraper::Models::Event::monitor_type

      attr_accessor occurred_at: Time

      attr_accessor type: XTwitterScraper::Models::stream_event_type

      attr_reader author_id: String?

      def author_id=: (String) -> String

      attr_reader author_username: String?

      def author_username=: (String) -> String

      attr_reader keyword_monitor_id: String?

      def keyword_monitor_id=: (String) -> String

      attr_reader monitor_name: String?

      def monitor_name=: (String) -> String

      attr_reader post_id: String?

      def post_id=: (String) -> String

      attr_reader post_url: String?

      def post_url=: (String) -> String

      attr_reader query: String?

      def query=: (String) -> String

      attr_reader username: String?

      def username=: (String) -> String

      attr_reader x_user_id: String?

      def x_user_id=: (String) -> String

      def initialize: (
        id: String,
        data: ::Hash[Symbol, top],
        monitor_id: String,
        monitor_type: XTwitterScraper::Models::Event::monitor_type,
        occurred_at: Time,
        type: XTwitterScraper::Models::stream_event_type,
        ?author_id: String,
        ?author_username: String,
        ?keyword_monitor_id: String,
        ?monitor_name: String,
        ?post_id: String,
        ?post_url: String,
        ?query: String,
        ?username: String,
        ?x_user_id: String
      ) -> void

      def to_hash: -> {
        id: String,
        data: ::Hash[Symbol, top],
        monitor_id: String,
        monitor_type: XTwitterScraper::Models::Event::monitor_type,
        occurred_at: Time,
        type: XTwitterScraper::Models::stream_event_type,
        author_id: String,
        author_username: String,
        keyword_monitor_id: String,
        monitor_name: String,
        post_id: String,
        post_url: String,
        query: String,
        username: String,
        x_user_id: String
      }

      type monitor_type = :account | :keyword | :post

      module MonitorType
        extend XTwitterScraper::Internal::Type::Enum

        ACCOUNT: :account
        KEYWORD: :keyword
        POST: :post

        def self?.values: -> ::Array[XTwitterScraper::Models::Event::monitor_type]
      end
    end
  end
end
