module XTwitterScraper
  module Models
    type account_retrieve_response =
      {
        monitor_billing: XTwitterScraper::Models::AccountRetrieveResponse::MonitorBilling,
        monitors_allowed: Integer,
        monitors_used: Integer,
        plan: XTwitterScraper::Models::AccountRetrieveResponse::plan,
        subscription: XTwitterScraper::Models::AccountRetrieveResponse::Subscription,
        credit_info: XTwitterScraper::Models::AccountRetrieveResponse::CreditInfo,
        x_username: String
      }

    class AccountRetrieveResponse < XTwitterScraper::Internal::Type::BaseModel
      attr_accessor monitor_billing: XTwitterScraper::Models::AccountRetrieveResponse::MonitorBilling

      attr_accessor monitors_allowed: Integer

      attr_accessor monitors_used: Integer

      attr_accessor plan: XTwitterScraper::Models::AccountRetrieveResponse::plan

      attr_accessor subscription: XTwitterScraper::Models::AccountRetrieveResponse::Subscription

      attr_reader credit_info: XTwitterScraper::Models::AccountRetrieveResponse::CreditInfo?

      def credit_info=: (
        XTwitterScraper::Models::AccountRetrieveResponse::CreditInfo
      ) -> XTwitterScraper::Models::AccountRetrieveResponse::CreditInfo

      attr_reader x_username: String?

      def x_username=: (String) -> String

      def initialize: (
        monitor_billing: XTwitterScraper::Models::AccountRetrieveResponse::MonitorBilling,
        monitors_allowed: Integer,
        monitors_used: Integer,
        plan: XTwitterScraper::Models::AccountRetrieveResponse::plan,
        subscription: XTwitterScraper::Models::AccountRetrieveResponse::Subscription | ::Hash[Symbol, top],
        ?credit_info: XTwitterScraper::Models::AccountRetrieveResponse::CreditInfo,
        ?x_username: String
      ) -> void

      def to_hash: -> {
        monitor_billing: XTwitterScraper::Models::AccountRetrieveResponse::MonitorBilling,
        monitors_allowed: Integer,
        monitors_used: Integer,
        plan: XTwitterScraper::Models::AccountRetrieveResponse::plan,
        subscription: XTwitterScraper::Models::AccountRetrieveResponse::Subscription,
        credit_info: XTwitterScraper::Models::AccountRetrieveResponse::CreditInfo,
        x_username: String
      }

      type monitor_billing =
        {
          active_daily_estimate: String,
          active_hourly_burn: String,
          credits_per_active_monitor_day: String,
          credits_per_active_monitor_hour: String,
          events_included: bool,
          instant_check_interval_seconds: Integer,
          unlimited_slots: bool
        }

      class MonitorBilling < XTwitterScraper::Internal::Type::BaseModel
        attr_accessor active_daily_estimate: String

        attr_accessor active_hourly_burn: String

        attr_accessor credits_per_active_monitor_day: String

        attr_accessor credits_per_active_monitor_hour: String

        attr_accessor events_included: bool

        attr_accessor instant_check_interval_seconds: Integer

        attr_accessor unlimited_slots: bool

        def initialize: (
          active_daily_estimate: String,
          active_hourly_burn: String,
          credits_per_active_monitor_day: String,
          credits_per_active_monitor_hour: String,
          events_included: bool,
          instant_check_interval_seconds: Integer,
          unlimited_slots: bool
        ) -> void

        def to_hash: -> {
          active_daily_estimate: String,
          active_hourly_burn: String,
          credits_per_active_monitor_day: String,
          credits_per_active_monitor_hour: String,
          events_included: bool,
          instant_check_interval_seconds: Integer,
          unlimited_slots: bool
        }
      end

      type plan = :active | :inactive

      module Plan
        extend XTwitterScraper::Internal::Type::Enum

        ACTIVE: :active
        INACTIVE: :inactive

        def self?.values: -> ::Array[XTwitterScraper::Models::AccountRetrieveResponse::plan]
      end

      type credit_info =
        {
          auto_topup_amount_dollars: Float,
          auto_topup_enabled: bool,
          auto_topup_stopped: bool,
          auto_topup_threshold: String,
          balance: String,
          lifetime_purchased: String,
          lifetime_used: String
        }

      class CreditInfo < XTwitterScraper::Internal::Type::BaseModel
        attr_accessor auto_topup_amount_dollars: Float

        attr_accessor auto_topup_enabled: bool

        attr_accessor auto_topup_stopped: bool

        attr_accessor auto_topup_threshold: String

        attr_accessor balance: String

        attr_accessor lifetime_purchased: String

        attr_accessor lifetime_used: String

        def initialize: (
          auto_topup_amount_dollars: Float,
          auto_topup_enabled: bool,
          auto_topup_stopped: bool,
          auto_topup_threshold: String,
          balance: String,
          lifetime_purchased: String,
          lifetime_used: String
        ) -> void

        def to_hash: -> {
          auto_topup_amount_dollars: Float,
          auto_topup_enabled: bool,
          auto_topup_stopped: bool,
          auto_topup_threshold: String,
          balance: String,
          lifetime_purchased: String,
          lifetime_used: String
        }
      end

      type subscription = ::Hash[Symbol, top]

      class Subscription < XTwitterScraper::Internal::Type::BaseModel
        attr_accessor status: XTwitterScraper::Models::AccountRetrieveResponse::Subscription::status

        attr_reader tier: XTwitterScraper::Models::AccountRetrieveResponse::Subscription::tier?

        def tier=: (
          XTwitterScraper::Models::AccountRetrieveResponse::Subscription::tier
        ) -> XTwitterScraper::Models::AccountRetrieveResponse::Subscription::tier

        attr_reader current_period_start: Time?

        def current_period_start=: (Time) -> Time

        attr_reader current_period_end: Time?

        def current_period_end=: (Time) -> Time

        def initialize: (
          status: XTwitterScraper::Models::AccountRetrieveResponse::Subscription::status,
          ?tier: XTwitterScraper::Models::AccountRetrieveResponse::Subscription::tier,
          ?current_period_start: Time,
          ?current_period_end: Time
        ) -> void

        def to_hash: -> ::Hash[Symbol, top]

        type status = :none | :active | :past_due | :canceling | :incomplete

        module Status
          extend XTwitterScraper::Internal::Type::Enum

          NONE: :none
          ACTIVE: :active
          PAST_DUE: :past_due
          CANCELING: :canceling
          INCOMPLETE: :incomplete

          def self?.values: -> ::Array[XTwitterScraper::Models::AccountRetrieveResponse::Subscription::status]
        end

        type tier = :starter | :pro | :business

        module Tier
          extend XTwitterScraper::Internal::Type::Enum

          STARTER: :starter
          PRO: :pro
          BUSINESS: :business

          def self?.values: -> ::Array[XTwitterScraper::Models::AccountRetrieveResponse::Subscription::tier]
        end
      end
    end
  end
end
