        ?verification_reason: XTwitterScraper::UserProfile::VerificationReason | ::Hash[Symbol, top],
        ?verified: bool,
        ?verified_type: String,
        ?withheld_in_countries: ::Array[String],
        ?withheld_scope: String
      ) -> void

