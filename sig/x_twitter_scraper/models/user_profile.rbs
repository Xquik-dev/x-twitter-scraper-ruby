      type affiliates_highlighted_label = ::Hash[Symbol, top]

      class AffiliatesHighlightedLabel < XTwitterScraper::Internal::Type::BaseModel
        attr_reader auxiliary_labels: ::Array[XTwitterScraper::UserProfile::AffiliatesHighlightedLabel::AuxiliaryLabel]?

        def auxiliary_labels=: (
          ::Array[XTwitterScraper::UserProfile::AffiliatesHighlightedLabel::AuxiliaryLabel | ::Hash[Symbol, top]]
        ) -> ::Array[XTwitterScraper::UserProfile::AffiliatesHighlightedLabel::AuxiliaryLabel]

        attr_reader badge_url: String?

        def badge_url=: (String) -> String

        attr_reader description: String?

        def description=: (String) -> String

        attr_reader long_description: ::Hash[Symbol, top]?

        def long_description=: (::Hash[Symbol, top]) -> ::Hash[Symbol, top]

        attr_reader url: String?

        def url=: (String) -> String

        attr_reader url_type: String?

        def url_type=: (String) -> String

        attr_reader user_label_display_type: String?

        def user_label_display_type=: (String) -> String

        attr_reader user_label_type: String?

        def user_label_type=: (String) -> String

        def initialize: (
          ?auxiliary_labels: ::Array[XTwitterScraper::UserProfile::AffiliatesHighlightedLabel::AuxiliaryLabel | ::Hash[Symbol, top]],
          ?badge_url: String,
          ?description: String,
          ?long_description: ::Hash[Symbol, top],
          ?url: String,
          ?url_type: String,
          ?user_label_display_type: String,
          ?user_label_type: String
        ) -> void

        def to_hash: -> ::Hash[Symbol, top]

        type auxiliary_label = ::Hash[Symbol, top]

        class AuxiliaryLabel < XTwitterScraper::Internal::Type::BaseModel
          attr_reader badge_url: String?

          def badge_url=: (String) -> String

          attr_reader description: String?

          def description=: (String) -> String

          attr_reader url: String?

          def url=: (String) -> String

          attr_reader user_label_display_type: String?

          def user_label_display_type=: (String) -> String

          attr_reader user_label_type: String?

          def user_label_type=: (String) -> String

          def initialize: (
            ?badge_url: String,
            ?description: String,
            ?url: String,
            ?user_label_display_type: String,
            ?user_label_type: String
          ) -> void

          def to_hash: -> ::Hash[Symbol, top]
        end
      end

      type highlights_info =
        { can_highlight_tweets: bool, highlighted_tweets: String }

      class HighlightsInfo < XTwitterScraper::Internal::Type::BaseModel
        attr_reader can_highlight_tweets: bool?

        def can_highlight_tweets=: (bool) -> bool

