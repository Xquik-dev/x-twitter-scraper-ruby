          ?is_identity_verified: bool,
          ?override_verified_year: Integer,
          ?verified_since_msec: String
        ) -> void

        def to_hash: -> ::Hash[Symbol, top]
      end

      type birthdate = ::Hash[Symbol, top]

      class Birthdate < XTwitterScraper::Internal::Type::BaseModel
        attr_reader day: Integer?

        def day=: (Integer) -> Integer

        attr_reader month: Integer?

        def month=: (Integer) -> Integer

        attr_reader year: Integer?

