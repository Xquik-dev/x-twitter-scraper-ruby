      type username_changes = ::Hash[Symbol, top]

      class UsernameChanges < XTwitterScraper::Internal::Type::BaseModel
        attr_accessor count: Integer

        attr_reader last_changed_at: Time?

        def last_changed_at=: (Time) -> Time

        def initialize: (count: Integer, ?last_changed_at: Time) -> void

        def to_hash: -> ::Hash[Symbol, top]
      end

      type verification_reason = ::Hash[Symbol, top]

      class VerificationReason < XTwitterScraper::Internal::Type::BaseModel
        attr_reader text: String?

        def text=: (String) -> String

        attr_reader entities: ::Array[XTwitterScraper::UserProfile::VerificationReason::Entity]?

        def entities=: (
          ::Array[XTwitterScraper::UserProfile::VerificationReason::Entity | ::Hash[Symbol, top]]
        ) -> ::Array[XTwitterScraper::UserProfile::VerificationReason::Entity]

        def initialize: (
          ?text: String,
          ?entities: ::Array[XTwitterScraper::UserProfile::VerificationReason::Entity | ::Hash[Symbol, top]]
        ) -> void

        def to_hash: -> ::Hash[Symbol, top]

        type entity = ::Hash[Symbol, top]

        class Entity < XTwitterScraper::Internal::Type::BaseModel
          attr_reader from_index: Integer?

          def from_index=: (Integer) -> Integer

          attr_reader to_index: Integer?

          def to_index=: (Integer) -> Integer

          attr_reader url: String?

          def url=: (String) -> String

          attr_reader url_type: String?

          def url_type=: (String) -> String

          def initialize: (
            ?from_index: Integer,
            ?to_index: Integer,
            ?url: String,
            ?url_type: String
          ) -> void

          def to_hash: -> ::Hash[Symbol, top]
        end
      end
