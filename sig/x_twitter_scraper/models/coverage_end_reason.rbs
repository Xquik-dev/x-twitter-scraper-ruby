module XTwitterScraper
  module Models
    type coverage_end_reason = :stalled

    module CoverageEndReason
      extend XTwitterScraper::Internal::Type::Enum

      STALLED: :stalled

      def self?.values: -> ::Array[XTwitterScraper::Models::coverage_end_reason]
    end
  end
end
