module XTwitterScraper
  module Models
    type extraction_run_response =
      {
        allowed: bool,
        credits_available: String,
        credits_required: String,
        estimated_results: Integer,
        source: String,
        resolved_x_user_id: String
      }

    class ExtractionRunResponse < XTwitterScraper::Internal::Type::BaseModel
      attr_reader allowed: bool?

      def allowed=: (bool) -> bool

      attr_reader credits_available: String?

      def credits_available=: (String) -> String

      attr_reader credits_required: String?

      def credits_required=: (String) -> String

      attr_reader estimated_results: Integer?

      def estimated_results=: (Integer) -> Integer

      attr_reader source: String?

      def source=: (String) -> String

      attr_reader resolved_x_user_id: String?

      def resolved_x_user_id=: (String) -> String

      def initialize: (
        ?allowed: bool,
        ?credits_available: String,
        ?credits_required: String,
        ?estimated_results: Integer,
        ?source: String,
        ?resolved_x_user_id: String
      ) -> void

      def to_hash: -> {
        allowed: bool,
        credits_available: String,
        credits_required: String,
        estimated_results: Integer,
        source: String,
        resolved_x_user_id: String
      }
    end
  end
end
