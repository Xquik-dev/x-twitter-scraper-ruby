module XTwitterScraper
  module Models
    type place =
      {
        id: String,
        name: String,
        full_name: String?,
        country: String?,
        country_code: String?,
        place_type: String?,
        url: String?,
        centroid: ::Array[Float]?,
        bounding_box: XTwitterScraper::Models::Place::BoundingBox?,
        attributes: ::Hash[Symbol, top]
      }

    class Place < XTwitterScraper::Internal::Type::BaseModel
      attr_accessor id: String

      attr_accessor name: String

      attr_accessor full_name: String?

      attr_accessor country: String?

      attr_accessor country_code: String?

      attr_accessor place_type: String?

      attr_accessor url: String?

      attr_accessor centroid: ::Array[Float]?

      attr_accessor bounding_box: XTwitterScraper::Models::Place::BoundingBox?

      attr_accessor attributes: ::Hash[Symbol, top]

      def initialize: (
        id: String,
        name: String,
        full_name: String?,
        country: String?,
        country_code: String?,
        place_type: String?,
        url: String?,
        centroid: ::Array[Float]?,
        bounding_box: XTwitterScraper::Models::Place::BoundingBox?,
        attributes: ::Hash[Symbol, top]
      ) -> void

      def to_hash: -> {
        id: String,
        name: String,
        full_name: String?,
        country: String?,
        country_code: String?,
        place_type: String?,
        url: String?,
        centroid: ::Array[Float]?,
        bounding_box: XTwitterScraper::Models::Place::BoundingBox?,
        attributes: ::Hash[Symbol, top]
      }

      type bounding_box =
        { type: String, coordinates: ::Array[::Array[::Array[Float]]] }

      class BoundingBox < XTwitterScraper::Internal::Type::BaseModel
        attr_accessor type: String

        attr_accessor coordinates: ::Array[::Array[::Array[Float]]]

        def initialize: (
          type: String,
          coordinates: ::Array[::Array[::Array[Float]]]
        ) -> void

        def to_hash: -> {
          type: String,
          coordinates: ::Array[::Array[::Array[Float]]]
        }
      end
    end
  end
end
