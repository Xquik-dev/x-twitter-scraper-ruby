module XTwitterScraper
  module Models
    type paginated_community_notes =
      {
        notes: ::Array[XTwitterScraper::Models::CommunityNote],
        has_next_page: bool,
        next_cursor: String
      }

    class PaginatedCommunityNotes < XTwitterScraper::Internal::Type::BaseModel
      attr_accessor notes: ::Array[XTwitterScraper::Models::CommunityNote]

      attr_accessor has_next_page: bool

      attr_accessor next_cursor: String

      def initialize: (
        notes: ::Array[XTwitterScraper::Models::CommunityNote],
        has_next_page: bool,
        next_cursor: String
      ) -> void

      def to_hash: -> {
        notes: ::Array[XTwitterScraper::Models::CommunityNote],
        has_next_page: bool,
        next_cursor: String
      }
    end
  end
end
