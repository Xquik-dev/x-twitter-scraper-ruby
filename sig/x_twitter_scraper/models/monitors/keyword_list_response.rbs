module XTwitterScraper
  module Models
    module Monitors
      type keyword_list_response =
        {
          has_more: bool,
          monitors: ::Array[XTwitterScraper::Models::Monitors::KeywordListResponse::Monitor],
          total: Integer,
          next_cursor: String
        }

      class KeywordListResponse < XTwitterScraper::Internal::Type::BaseModel
        attr_accessor has_more: bool

        attr_accessor monitors: ::Array[XTwitterScraper::Models::Monitors::KeywordListResponse::Monitor]

        attr_accessor total: Integer

        attr_reader next_cursor: String?

        def next_cursor=: (String) -> String

        def initialize: (
          has_more: bool,
          monitors: ::Array[XTwitterScraper::Models::Monitors::KeywordListResponse::Monitor],
          total: Integer,
          ?next_cursor: String
        ) -> void

        def to_hash: -> {
          has_more: bool,
          monitors: ::Array[XTwitterScraper::Models::Monitors::KeywordListResponse::Monitor],
          total: Integer,
          next_cursor: String
        }

        type monitor =
          {
            id: String,
            created_at: Time,
            event_types: ::Array[XTwitterScraper::Models::event_type],
            is_active: bool,
            next_billing_at: Time,
            query: String,
            name: String,
            paused_at: Time,
            paused_reason: XTwitterScraper::Models::Monitors::KeywordListResponse::Monitor::paused_reason
          }

        class Monitor < XTwitterScraper::Internal::Type::BaseModel
          attr_accessor id: String

          attr_accessor created_at: Time

          attr_accessor event_types: ::Array[XTwitterScraper::Models::event_type]

          attr_accessor is_active: bool

          attr_accessor next_billing_at: Time

          attr_accessor query: String

          attr_reader name: String?

          def name=: (String) -> String

          attr_reader paused_at: Time?

          def paused_at=: (Time) -> Time

          attr_reader paused_reason: XTwitterScraper::Models::Monitors::KeywordListResponse::Monitor::paused_reason?

          def paused_reason=: (
            XTwitterScraper::Models::Monitors::KeywordListResponse::Monitor::paused_reason
          ) -> XTwitterScraper::Models::Monitors::KeywordListResponse::Monitor::paused_reason

          def initialize: (
            id: String,
            created_at: Time,
            event_types: ::Array[XTwitterScraper::Models::event_type],
            is_active: bool,
            next_billing_at: Time,
            query: String,
            ?name: String,
            ?paused_at: Time,
            ?paused_reason: XTwitterScraper::Models::Monitors::KeywordListResponse::Monitor::paused_reason
          ) -> void

          def to_hash: -> {
            id: String,
            created_at: Time,
            event_types: ::Array[XTwitterScraper::Models::event_type],
            is_active: bool,
            next_billing_at: Time,
            query: String,
            name: String,
            paused_at: Time,
            paused_reason: XTwitterScraper::Models::Monitors::KeywordListResponse::Monitor::paused_reason
          }

          type paused_reason = :insufficient_credits

          module PausedReason
            extend XTwitterScraper::Internal::Type::Enum

            INSUFFICIENT_CREDITS: :insufficient_credits

            def self?.values: -> ::Array[XTwitterScraper::Models::Monitors::KeywordListResponse::Monitor::paused_reason]
          end
