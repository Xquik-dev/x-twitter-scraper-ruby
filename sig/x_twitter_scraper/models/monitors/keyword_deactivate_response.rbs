module XTwitterScraper
  module Models
    module Monitors
      type keyword_deactivate_response =
        {
          deletion_status: :deleting,
          status_url: String,
          success: true
        }

      class KeywordDeactivateResponse < XTwitterScraper::Internal::Type::BaseModel
        attr_accessor deletion_status: :deleting

        attr_accessor status_url: String

        attr_accessor success: true

        def initialize: (
          ?deletion_status: :deleting,
          status_url: String,
          ?success: true
        ) -> void

        def to_hash: -> {
          deletion_status: :deleting,
          status_url: String,
          success: true
        }
      end
    end
  end
end
