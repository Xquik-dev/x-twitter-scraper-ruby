          is_active: bool,
          next_billing_at: Time,
          query: String,
          name: String,
          paused_at: Time,
          paused_reason: XTwitterScraper::Models::Monitors::KeywordRetrieveResponse::paused_reason
        }

      class KeywordRetrieveResponse < XTwitterScraper::Internal::Type::BaseModel
        attr_accessor id: String

        attr_accessor created_at: Time

        attr_accessor event_types: ::Array[XTwitterScraper::Models::event_type]

        attr_accessor is_active: bool

        attr_accessor next_billing_at: Time

        attr_accessor query: String

        attr_reader name: String?

        def name=: (String) -> String

        attr_reader paused_at: Time?

        def paused_at=: (Time) -> Time

        attr_reader paused_reason: XTwitterScraper::Models::Monitors::KeywordRetrieveResponse::paused_reason?

        def paused_reason=: (
