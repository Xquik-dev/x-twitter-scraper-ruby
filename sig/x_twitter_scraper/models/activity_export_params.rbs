module XTwitterScraper
  module Models
    type activity_export_params =
      {
        format_: XTwitterScraper::Models::ActivityExportParams::format_,
        limit: Integer,
        category: String,
        status: String,
        q: String,
        since: XTwitterScraper::Models::ActivityExportParams::since,
        until_: XTwitterScraper::Models::ActivityExportParams::until_
      }
      & XTwitterScraper::Internal::Type::request_parameters

    class ActivityExportParams < XTwitterScraper::Internal::Type::BaseModel
      extend XTwitterScraper::Internal::Type::RequestParameters::Converter
      include XTwitterScraper::Internal::Type::RequestParameters

      attr_accessor format_: XTwitterScraper::Models::ActivityExportParams::format_

      attr_reader limit: Integer?

      def limit=: (Integer) -> Integer

      attr_reader category: String?

      def category=: (String) -> String

      attr_reader status: String?

      def status=: (String) -> String

      attr_reader q: String?

      def q=: (String) -> String

      attr_reader since: XTwitterScraper::Models::ActivityExportParams::since?

      def since=: (
        XTwitterScraper::Models::ActivityExportParams::since
      ) -> XTwitterScraper::Models::ActivityExportParams::since

      attr_reader until_: XTwitterScraper::Models::ActivityExportParams::until_?

      def until_=: (
        XTwitterScraper::Models::ActivityExportParams::until_
      ) -> XTwitterScraper::Models::ActivityExportParams::until_

      def initialize: (
        format_: XTwitterScraper::Models::ActivityExportParams::format_,
        ?limit: Integer,
        ?category: String,
        ?status: String,
        ?q: String,
        ?since: XTwitterScraper::Models::ActivityExportParams::since,
        ?until_: XTwitterScraper::Models::ActivityExportParams::until_,
        ?request_options: XTwitterScraper::request_opts
      ) -> void

      def to_hash: -> {
        format_: XTwitterScraper::Models::ActivityExportParams::format_,
        limit: Integer,
        category: String,
        status: String,
        q: String,
        since: XTwitterScraper::Models::ActivityExportParams::since,
        until_: XTwitterScraper::Models::ActivityExportParams::until_,
        request_options: XTwitterScraper::RequestOptions
      }

      type format_ = :json | :csv | :xlsx | :md | :"md-document" | :pdf | :txt

      module Format
        extend XTwitterScraper::Internal::Type::Enum

        JSON: :json
        CSV: :csv
        XLSX: :xlsx
        MD: :md
        MD_DOCUMENT: :"md-document"
        PDF: :pdf
        TXT: :txt

        def self?.values: -> ::Array[XTwitterScraper::Models::ActivityExportParams::format_]
      end

      type since = String | Time

      module Since
        extend XTwitterScraper::Internal::Type::Union

        def self?.variants: -> ::Array[XTwitterScraper::Models::ActivityExportParams::since]
      end

      type until_ = String | Time

      module Until
        extend XTwitterScraper::Internal::Type::Union

        def self?.variants: -> ::Array[XTwitterScraper::Models::ActivityExportParams::until_]
      end
    end
  end
end
