module XTwitterScraper
  module Models
    module X
      type media_upload_params =
        {
          account: String,
          url: String,
          idempotency_key: String,
          file: XTwitterScraper::Internal::file_input,
          is_long_video: bool
        }
        & XTwitterScraper::Internal::Type::request_parameters

      class MediaUploadParams < XTwitterScraper::Internal::Type::BaseModel
        extend XTwitterScraper::Internal::Type::RequestParameters::Converter
        include XTwitterScraper::Internal::Type::RequestParameters

        attr_accessor account: String

        attr_reader url: String?

        def url=: (String) -> String

        attr_accessor idempotency_key: String

        attr_reader file: XTwitterScraper::Internal::file_input?

        def file=: (
          XTwitterScraper::Internal::file_input
        ) -> XTwitterScraper::Internal::file_input

        attr_reader is_long_video: bool?

        def is_long_video=: (bool) -> bool

        def initialize: (
          account: String,
          idempotency_key: String,
          ?file: XTwitterScraper::Internal::file_input,
          ?is_long_video: bool,
          ?url: String,
          ?request_options: XTwitterScraper::request_opts
        ) -> void

        def to_hash: -> {
          account: String,
          url: String,
          idempotency_key: String,
          file: XTwitterScraper::Internal::file_input,
          is_long_video: bool,
          request_options: XTwitterScraper::RequestOptions
        }
      end
    end
  end
end
