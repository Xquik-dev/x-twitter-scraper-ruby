        attr_accessor requested_count: Integer

        attr_accessor returned_count: Integer

        attr_accessor unavailable_ids: ::Array[String]

        attr_accessor unprocessed_ids: ::Array[String]

        attr_accessor users: ::Array[XTwitterScraper::UserProfile]

        attr_reader filtered_count: Integer?

        def filtered_count=: (Integer) -> Integer

        def initialize: (
          next_cursor: String,
          processed_count: Integer,
          requested_count: Integer,
          returned_count: Integer,
