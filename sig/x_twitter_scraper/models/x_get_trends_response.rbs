module XTwitterScraper
  module Models
    type x_get_trends_response =
      {
        count: Integer,
        trends: ::Array[XTwitterScraper::Models::XGetTrendsResponse::Trend],
        woeid: Integer,
        captured_at: Time,
        location: XTwitterScraper::Models::XGetTrendsResponse::Location,
        requested_at: Time
      }

    class XGetTrendsResponse < XTwitterScraper::Internal::Type::BaseModel
      attr_accessor count: Integer

      attr_accessor trends: ::Array[XTwitterScraper::Models::XGetTrendsResponse::Trend]

      attr_accessor woeid: Integer

      attr_reader captured_at: Time?

      def captured_at=: (Time) -> Time

      attr_reader location: XTwitterScraper::Models::XGetTrendsResponse::Location?

      def location=: (
        XTwitterScraper::Models::XGetTrendsResponse::Location | ::Hash[Symbol, top]
      ) -> XTwitterScraper::Models::XGetTrendsResponse::Location

      attr_reader requested_at: Time?

      def requested_at=: (Time) -> Time

      def initialize: (
        count: Integer,
        trends: ::Array[XTwitterScraper::Models::XGetTrendsResponse::Trend],
        woeid: Integer,
        ?captured_at: Time,
        ?location: XTwitterScraper::Models::XGetTrendsResponse::Location | ::Hash[Symbol, top],
        ?requested_at: Time
      ) -> void

      def to_hash: -> {
        count: Integer,
        trends: ::Array[XTwitterScraper::Models::XGetTrendsResponse::Trend],
        woeid: Integer,
        captured_at: Time,
        location: XTwitterScraper::Models::XGetTrendsResponse::Location,
        requested_at: Time
      }

      type trend =
        {
          name: String,
          description: String,
          promoted_content: String?,
          query: String,
          rank: Integer,
          tweet_volume: Integer?,
          url: String
        }

      class Trend < XTwitterScraper::Internal::Type::BaseModel
        attr_accessor name: String

        attr_reader description: String?

        def description=: (String) -> String

        attr_accessor promoted_content: String?

        attr_reader query: String?

        def query=: (String) -> String

        attr_reader rank: Integer?

        def rank=: (Integer) -> Integer

        attr_accessor tweet_volume: Integer?

        attr_reader url: String?

        def url=: (String) -> String

        def initialize: (
          name: String,
          ?description: String,
          ?promoted_content: String?,
          ?query: String,
          ?rank: Integer,
          ?tweet_volume: Integer?,
          ?url: String
        ) -> void

        def to_hash: -> {
          name: String,
          description: String,
          promoted_content: String?,
          query: String,
          rank: Integer,
          tweet_volume: Integer?,
          url: String
        }
      end

      type location = ::Hash[Symbol, top]

      class Location < XTwitterScraper::Internal::Type::BaseModel
        attr_accessor woeid: Integer

        attr_accessor name: String

        attr_accessor country: String?

        attr_accessor country_code: String?

        attr_accessor place_type: String?

        attr_accessor place_type_code: Integer?

        attr_accessor parent_woeid: Integer?

        attr_accessor url: String?

        def initialize: (
          woeid: Integer,
          name: String,
          country: String?,
          country_code: String?,
          place_type: String?,
          place_type_code: Integer?,
          parent_woeid: Integer?,
          url: String?
        ) -> void

        def to_hash: -> ::Hash[Symbol, top]
