module XTwitterScraper
  module Models
    type x_autocomplete_search_params =
      { q: String, types: String, limit: Integer, fields: String, omit: String }
      & XTwitterScraper::Internal::Type::request_parameters

    class XAutocompleteSearchParams < XTwitterScraper::Internal::Type::BaseModel
      extend XTwitterScraper::Internal::Type::RequestParameters::Converter
      include XTwitterScraper::Internal::Type::RequestParameters

      attr_accessor q: String

      attr_reader types: String?

      def types=: (String) -> String

      attr_reader limit: Integer?

      def limit=: (Integer) -> Integer

      attr_reader fields: String?

      def fields=: (String) -> String

      attr_reader omit: String?

      def omit=: (String) -> String

      def initialize: (
        q: String,
        ?types: String,
        ?limit: Integer,
        ?fields: String,
        ?omit: String,
        ?request_options: XTwitterScraper::request_opts
      ) -> void

      def to_hash: -> {
        q: String,
        types: String,
        limit: Integer,
        fields: String,
        omit: String,
        request_options: XTwitterScraper::RequestOptions
      }
    end
  end
end
