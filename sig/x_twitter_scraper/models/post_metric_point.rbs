module XTwitterScraper
  module Models
    type post_metric_point = { value: Integer?, gain: Integer? }

    class PostMetricPoint < XTwitterScraper::Internal::Type::BaseModel
      attr_accessor value: Integer?

      attr_accessor gain: Integer?

      def initialize: (value: Integer?, gain: Integer?) -> void

      def to_hash: -> { value: Integer?, gain: Integer? }
    end
  end
end
