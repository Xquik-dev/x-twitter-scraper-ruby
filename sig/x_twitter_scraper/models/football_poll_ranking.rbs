module XTwitterScraper
  module Models
    type football_poll_ranking = { team_id: String?, rank: Integer? }

    class FootballPollRanking < XTwitterScraper::Internal::Type::BaseModel
      attr_accessor team_id: String?

      attr_accessor rank: Integer?

      def initialize: (team_id: String?, rank: Integer?) -> void

      def to_hash: -> { team_id: String?, rank: Integer? }
    end
  end
end
