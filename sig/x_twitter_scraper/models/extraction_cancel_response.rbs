module XTwitterScraper
  module Models
    type extraction_cancel_response = { id: String, status: :canceled }

    class ExtractionCancelResponse < XTwitterScraper::Internal::Type::BaseModel
      attr_accessor id: String

      attr_accessor status: :canceled

      def initialize: (id: String, ?status: :canceled) -> void

      def to_hash: -> { id: String, status: :canceled }
    end
  end
end
