module XTwitterScraper
  module Models
    type profile_translation =
      {
        user_id: String,
        user_name: String,
        language: String,
        source_language: String,
        text: String,
        entities: XTwitterScraper::Models::TweetEntities
      }

    class ProfileTranslation < XTwitterScraper::Internal::Type::BaseModel
      attr_accessor user_id: String

      attr_accessor user_name: String

      attr_accessor language: String

      attr_reader source_language: String?

      def source_language=: (String) -> String

      attr_accessor text: String

      attr_accessor entities: XTwitterScraper::Models::TweetEntities

      def initialize: (
        user_id: String,
        user_name: String,
        language: String,
        text: String,
        entities: XTwitterScraper::Models::TweetEntities,
        ?source_language: String
      ) -> void

      def to_hash: -> {
        user_id: String,
        user_name: String,
        language: String,
        source_language: String,
        text: String,
        entities: XTwitterScraper::Models::TweetEntities
      }
    end
  end
end
