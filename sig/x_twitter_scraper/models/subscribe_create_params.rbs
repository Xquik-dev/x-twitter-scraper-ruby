        PLN: :PLN
        QAR: :QAR
        RON: :RON
        SAR: :SAR
        SEK: :SEK
        SGD: :SGD
        THB: :THB
        ZAR: :ZAR

        def self?.values: -> ::Array[XTwitterScraper::Models::SubscribeCreateParams::currency]
      end
    end
  end
