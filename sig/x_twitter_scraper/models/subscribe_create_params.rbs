module XTwitterScraper
  module Models
    type subscribe_create_params =
      {
        currency: XTwitterScraper::Models::SubscribeCreateParams::currency,
        tier: XTwitterScraper::Models::SubscribeCreateParams::tier
      }
      & XTwitterScraper::Internal::Type::request_parameters

    class SubscribeCreateParams < XTwitterScraper::Internal::Type::BaseModel
      extend XTwitterScraper::Internal::Type::RequestParameters::Converter
      include XTwitterScraper::Internal::Type::RequestParameters

      attr_reader currency: XTwitterScraper::Models::SubscribeCreateParams::currency?

      def currency=: (
        XTwitterScraper::Models::SubscribeCreateParams::currency
      ) -> XTwitterScraper::Models::SubscribeCreateParams::currency

      attr_reader tier: XTwitterScraper::Models::SubscribeCreateParams::tier?

      def tier=: (
        XTwitterScraper::Models::SubscribeCreateParams::tier
      ) -> XTwitterScraper::Models::SubscribeCreateParams::tier

      def initialize: (
        ?currency: XTwitterScraper::Models::SubscribeCreateParams::currency,
        ?tier: XTwitterScraper::Models::SubscribeCreateParams::tier,
        ?request_options: XTwitterScraper::request_opts
      ) -> void

      def to_hash: -> {
        currency: XTwitterScraper::Models::SubscribeCreateParams::currency,
        tier: XTwitterScraper::Models::SubscribeCreateParams::tier,
        request_options: XTwitterScraper::RequestOptions
      }

      type tier = :starter | :pro | :business

      module Tier
        extend XTwitterScraper::Internal::Type::Enum

        STARTER: :starter
        PRO: :pro
        BUSINESS: :business

        def self?.values: -> ::Array[XTwitterScraper::Models::SubscribeCreateParams::tier]
      end

      type currency =
        :USD
        | :EUR
        | :GBP
        | :TRY
        | :JPY
        | :CNY
        | :KRW
        | :CAD
        | :AUD
        | :MXN
        | :AED
        | :BRL
        | :CHF
        | :CZK
        | :DKK
        | :HKD
        | :HUF
        | :IDR
        | :ILS
        | :INR
        | :MYR
        | :NOK
        | :NZD
        | :PHP
        | :PLN
        | :QAR
        | :RON
        | :SAR
        | :SEK
        | :SGD
        | :THB
        | :ZAR

      module Currency
        extend XTwitterScraper::Internal::Type::Enum

        USD: :USD
        EUR: :EUR
        GBP: :GBP
        TRY: :TRY
        JPY: :JPY
        CNY: :CNY
        KRW: :KRW
        CAD: :CAD
        AUD: :AUD
        MXN: :MXN
        AED: :AED
        BRL: :BRL
        CHF: :CHF
        CZK: :CZK
